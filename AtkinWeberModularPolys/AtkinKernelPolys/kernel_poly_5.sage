# 5-th Atkin kernel polynomial
kernel_poly = x^2 + (((2*Y^3 - 8*Y^2 - 532*Y - 432)/(Y^3 - 10*Y^2 - 224*Y + 480))*j + (-12*Y^4 + 960*Y^3 + 1021824*Y^2 + 37985280*Y + 354628608)/(Y^3 - 10*Y^2 - 224*Y + 480))*x + ((5*Y^8 + 10*Y^7 - 4890*Y^6 - 29540*Y^5 + 1353980*Y^4 + 11518800*Y^3 - 85269760*Y^2 - 797361920*Y - 213709824)/(5*Y^3 - 50*Y^2 - 1120*Y + 2400))*j + (-5*Y^9 - 3730*Y^8 - 986300*Y^7 - 105764800*Y^6 - 3685504256*Y^5 - 29790257920*Y^4 + 848565191680*Y^3 + 19449142108160*Y^2 + 132873204367360*Y + 235886192295936)/(5*Y^3 - 50*Y^2 - 1120*Y + 2400)
