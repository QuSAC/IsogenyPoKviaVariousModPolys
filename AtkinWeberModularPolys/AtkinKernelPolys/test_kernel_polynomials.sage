}

def test_Atkin_kernel_polynomial(l, universe = None, p = None, e = None): 
    """
    This method tests the Atkin kernel polynomial formulas.

    INPUT:
        - l: The prime degree of isogenies we want to consider
        - universe: A string deciding whether the test takes place
            - in QQbar (if universe == "alg"), or
            - in GF(p^e) (if universe == "fin")
        - p: A given prime characteristic
        - e: The extension degree of QQ resp. of GF(p)

    WARNING: The QQbar-testing is quite slow even for slightly larger l and e!
    """
    global kernel_poly, x, j, Y

    # Decide in which ambient space to run the test
    univ_list = ["fin", "alg"]

    # If p is given, assume that a finite field should be considered
    if p and not universe:
        universe = "fin"
    
    # If no universe is picked, choose one at random
    if universe not in univ_list:
        universe = random.choice(univ_list)

    # Restrict to 0 < e < 9 for efficiency reasons
    if e not in range(1,9):
        e = randint(1,8)

    # Initialize the sampling space
    if universe == "fin":
        if p and p not in [2,3,l]:
            assert is_prime(p)
        else:
            # Sample a large prime if the given input is not suitable
            p = random_prime(2^16, 2^20)

        F = GF(p^e, "a")
        print(f"Sampling in the finite field with {p}^{e} elements ...")

    else:
        F = QQbar
        print(f"Sampling an algebraic number satisfying a degree {e} equation ...")

    # Sample a random starting j-invariant
    j0 = F.random_element(e)

    # The formula does not work for j0 = 0 and j0 = 1728, so resample if necessary
    while j0 * (j0-1728) == 0:
        print(f"Hit the special j-invariant {j0}, resampling!")
        j0 = F.random_element(e)

    # Set up the necessary polynomial rings ...
    R.<Y> = F[]
    T.<x> = R[]
    S.<j> = T[]
    
    # ... and load the Atkin modular polynomial
    Xi = AtkinModPoly[l](Y,j)

    # In the finite field case, extend F to be a splitting field of Xi at j0
    if universe == "fin":
        F.<b>, embed = F.extension(lcm([t.degree() for (t,e) in R(Xi(j=j0)).factor()]), map=True)
        R_ext.<Y> = F[]

        # Compute the coefficient-wise embedding of polynomial rings ...
        coeff_embed = R.hom([Y], R_ext, embed)
        
        # ... and extend everything to the splitting field
        j0 = embed(j0)
        Xi = Xi.map_coefficients(coeff_embed)
        R = R_ext
        T.<x> = R[]
        S.<j> = T[]
    
    # Pick a random root of the Atkin modular polynomial at j=j0
    f = random.choice(R(Xi(j=j0)).roots())[0] 

    # If the root f is a double root, the formula will fail since it cannot distinguish
    # between two non-equivalent dual isogenies; therefore, resample the root in that case
    # NOTE: For small p this might loop infinitely
    Deriv = R(Xi(j=j0)).derivative()
    while Deriv(Y=f) == 0:
        f = random.choice(R(Xi(j=j0)).roots())[0]

    # Set up the standard model curve for j0
    A = -3*j0*(j0-1728)
    B = -2*j0*(j0-1728)^2
    E = EllipticCurve(F, [A,B])
    assert E.j_invariant() == j0

    # Load the kernel polynomial formula ...   
    load(f"kernel_poly_{l}.sage")

    # ... and turn it into a kernel polynomial for the curve E
    isogeny_poly = T(kernel_poly(j=j0,Y=f))

    # Compute the isogeny given by this kernel polynomial ...
    phi = E.isogeny(kernel=isogeny_poly)

    # ... and the j-invariant of the codomain curve
    j1 = phi.codomain().j_invariant()

    # Finally, confirm that the isogeny corresponding to f has the correct codomain j-invariant
    assert Xi(Y=f) == (j-j0) * (j-j1)
    
    if universe == "fin":
        print(f"The random kernel polynomial test was successful for l = {l} over the finite field of order {p}^{e}!\n")
        print(f"Explicitly, it started from the standard model for j0 = {embed.inverse_image(j0)} = {j0}\n")
        print(f"Then it took the kernel polynomial isogeny from j0 given by the root {f}\n")
        print(f"And ended up at the j-invariant j1 = {j1}!\n")

    else:
        print(f"The random kernel polynomial test was correct for l = {l} in the algebraic numbers!\n")
        print(f"Explicitly, it started from the standard model for j0 = {j0} satisfying {j0.minpoly()} = 0\n")
        print(f"Then it took the kernel polynomial isogeny from j0 given by the root {f} satisyfing {f.minpoly()} = 0\n")
        print(f"And ended up at the j-invariant j1 = {j1} satisfying {j1.minpoly()} = 0!\n")
        
    print(f"Finally, it confirmed that the {l}-th Atkin modular polynomial has exactly the above roots j0 and j1 when evaluated (in Y) at the chosen isogeny root!\n")
